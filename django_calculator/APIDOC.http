#API call for adding two numbers

###
POST http://localhost:8000/addition/
Content-Type: application/json

{
    "num1": 400,
    "num2": 100
}

#API call for substracting two numbers
###
POST http://localhost:8000/subtraction/
Content-Type: application/json

{
    "num1" : 1000,
    "num2" : 500
}

###
POST http://localhost:8000/multiplication/
Content-Type: application/json

{
    "num1" : 100,
    "num2" : 5
}

###
POST http://localhost:8000/division/
Content-Type: application/json

{
    "num1" : 1000,
    "num2" : 2
}

###
POST http://localhost:8000/modulus/
Content-Type: application/json

{
    "num1" : 10,
    "num2" : 8
}

#API claa for calculate percentage
###
POST http://localhost:8000/percentage/
Content-Type: application/json

{
    "obtained_marks" : 400,
    "total_marks" : 500
}
